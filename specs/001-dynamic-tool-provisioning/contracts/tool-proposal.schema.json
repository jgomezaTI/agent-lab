{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.local/contracts/tool-proposal.schema.json",
  "title": "Tool Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "name", "description", "input_schema", "output_schema", "permissions", "data_sources", "risk_level", "graph_references", "lifecycle_state"],
  "properties": {
    "proposal_id": { "type": "string", "minLength": 8 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
    "description": { "type": "string", "minLength": 10 },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "permissions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "data_sources": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "risk_level": { "enum": ["read_only", "sensitive_read", "write", "irreversible"] },
    "graph_references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "lifecycle_state": { "enum": ["draft", "validation_failed", "review", "approved", "published", "deprecated", "rejected"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_id", "source_commit"],
      "properties": {
        "graph_id": { "type": "string", "minLength": 8 },
        "source_commit": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string" }
      }
    }
  }
}
