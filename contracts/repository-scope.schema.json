{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlab.local/contracts/repository-scope.schema.json",
  "title": "Repository Scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope_id", "product_id", "environment", "include"],
  "properties": {
    "scope_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "product_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "environment": { "enum": ["local", "sandbox", "staging", "production"] },
    "include": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "languages": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "ignore_hidden": { "type": "boolean", "default": true },
    "follow_symlinks": { "type": "boolean", "default": false },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_file_size_bytes": { "type": "integer", "minimum": 1 },
        "include_extensions": { "type": "array", "items": { "type": "string" } },
        "detect_tests": { "type": "boolean", "default": true }
      }
    }
  }
}
